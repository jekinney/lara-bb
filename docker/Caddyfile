{
	frankenphp
	order php_server before file_server
	# Behind a load balancer set TRUSTED_PROXIES in .env as well.
	servers {
		trusted_proxies static private_ranges
	}
}

{$SERVER_NAME::80} {
	root * /app/public
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Files uploaded through the app are served by the app, never executed from storage.
	@hidden path /.* /storage/* /vendor/*
	respond @hidden 404

	# Theme packages and build assets are versioned, so they can be cached hard.
	@immutable path /build/* /themes/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	php_server
}
